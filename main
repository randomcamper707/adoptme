	local function requestButton(text, baseColor, shadeColor, x)
		local underlay = Instance.new("Frame")
		underlay.Position = UDim2.new(x, 0, 0, 264)
		underlay.Size = UDim2.new(0.32, 0, 0, 52)
		underlay.BackgroundColor3 = shadeColor
		underlay.BorderSizePixel = 0
		underlay.ZIndex = 3
		underlay.Parent = paper
		local underCorner = Instance.new("UICorner")
		underCorner.CornerRadius = UDim.new(0, 10)
		underCorner.Parent = underlay

		local button = Instance.new("TextButton")
		button.Position = UDim2.new(x, 0, 0, 259)
		button.Size = UDim2.new(0.32, 0, 0, 48)
		button.BackgroundColor3 = baseColor
		button.BorderSizePixel = 0
		button.AutoButtonColor = true
		button.Font = Enum.Font.Cartoon
		button.Text = text
		button.TextColor3 = Color3.new(1, 1, 1)
		button.TextSize = 27
		button.ZIndex = 4
		button.Parent = paper

		local buttonCorner = Instance.new("UICorner")
		buttonCorner.CornerRadius = UDim.new(0, 10)
		buttonCorner.Parent = button
		local buttonStroke = Instance.new("UIStroke")
		buttonStroke.Color = shadeColor
		buttonStroke.Thickness = 1
		buttonStroke.Parent = button
		return button
	end

	local decline = requestButton("Decline", Color3.fromRGB(227, 37, 57),
		Color3.fromRGB(168, 25, 43), 0.12)
	local accept = requestButton("Accept", Color3.fromRGB(65, 204, 83),
		Color3.fromRGB(43, 155, 59), 0.56)

	decline.Activated:Connect(function()
		if activeTradePreview then activeTradePreview:Destroy() end
	end)
	accept.Activated:Connect(function()
		showTradeWindow(name)
	end)
end
startTradeButton.Activated:Connect(showTradeRequest)

