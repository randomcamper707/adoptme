-- Single-script UI and local avatar previews for your own Roblox experience.
-- Place this LocalScript in StarterPlayer > StarterPlayerScripts.
-- Preview avatars are created on this client and are not replicated to other players.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local oldGui = playerGui:FindFirstChild("EditableGamePanel")
if oldGui then
	oldGui:Destroy()
end

local COLORS = {
	background = Color3.fromRGB(17, 19, 29),
	panel = Color3.fromRGB(25, 28, 41),
	panelLight = Color3.fromRGB(36, 40, 57),
	border = Color3.fromRGB(62, 68, 91),
	text = Color3.fromRGB(244, 245, 255),
	muted = Color3.fromRGB(157, 165, 188),
	purple = Color3.fromRGB(137, 105, 255),
	cyan = Color3.fromRGB(83, 207, 226),
}

local function create(className, properties, parent)
	local object = Instance.new(className)
	for property, value in pairs(properties) do
		object[property] = value
	end
	object.Parent = parent
	return object
end

local function addCorner(object, radius)
	create("UICorner", {CornerRadius = UDim.new(0, radius)}, object)
end

local function addStroke(object, color, transparency)
	create("UIStroke", {
		Color = color or COLORS.border,
		Transparency = transparency or 0,
		Thickness = 1,
	}, object)
end

local function addLabel(parent, text, position, size, fontSize, color, font)
	return create("TextLabel", {
		BackgroundTransparency = 1,
		Position = position,
		Size = size,
		Font = font or Enum.Font.Gotham,
		Text = text,
		TextSize = fontSize,
		TextColor3 = color or COLORS.text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextWrapped = true,
	}, parent)
end

local MAX_PREVIEWS = 6
local SPAWN_COOLDOWN = 1
local FIVE_INCHES_IN_STUDS = 5 / 11.02

-- Add your UserId here if your own test experience is group-owned.
-- Studio and user-owned experiences are allowed automatically.
local LOCAL_ALLOWED_USER_IDS = {}

-- Optional Roblox UserIds to include in the random-avatar pool.
-- Players in the current server are also included automatically.
local RANDOM_USER_IDS = {}

local rng = Random.new()
local localPreviews = {}
local lastSpawnAt = 0
local isSpawning = false

local function canUseLocalPreview()
	if RunService:IsStudio() then
		return true
	end
	if game.CreatorType == Enum.CreatorType.User and game.CreatorId == player.UserId then
		return true
	end
	return table.find(LOCAL_ALLOWED_USER_IDS, player.UserId) ~= nil
end

local function randomDescription()
	local skinTones = {
		Color3.fromRGB(255, 224, 189),
		Color3.fromRGB(241, 194, 125),
		Color3.fromRGB(198, 134, 66),
		Color3.fromRGB(141, 85, 36),
		Color3.fromRGB(255, 219, 172),
	}
	local tone = skinTones[rng:NextInteger(1, #skinTones)]
	local description = Instance.new("HumanoidDescription")
	description.HeadColor = tone
	description.TorsoColor = tone
	description.LeftArmColor = tone
	description.RightArmColor = tone
	description.LeftLegColor = tone
	description.RightLegColor = tone
	description.HeightScale = rng:NextNumber(0.9, 1.08)
	description.WidthScale = rng:NextNumber(0.85, 1.08)
	description.DepthScale = rng:NextNumber(0.85, 1.08)
	description.HeadScale = rng:NextNumber(0.92, 1.12)
	description.BodyTypeScale = rng:NextNumber(0, 0.6)
	description.ProportionScale = rng:NextNumber(0, 0.6)
	return description
end

local function getActivePreviews()
	local active = {}
	for index = #localPreviews, 1, -1 do
		local model = localPreviews[index]
		if model and model.Parent then
			table.insert(active, model)
		else
			table.remove(localPreviews, index)
		end
	end
	return active
end

local function clearLocalPreviews()
	local active = getActivePreviews()
	for _, model in ipairs(active) do
		model:Destroy()
	end
	table.clear(localPreviews)
	return #active
end

local function createLocalPreview(description, displayName, sourceUserId)
	local createOk, modelOrError = pcall(function()
		return Players:CreateHumanoidModelFromDescriptionAsync(description, Enum.HumanoidRigType.R15)
	end)
	description:Destroy()
	if not createOk then
		error(tostring(modelOrError))
	end

	local model = modelOrError
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root then
		model:Destroy()
		error("Roblox returned an incomplete avatar model.")
	end

	local character = player.Character or player.CharacterAdded:Wait()
	local playerRoot = character:WaitForChild("HumanoidRootPart", 10)
	if not playerRoot then
		model:Destroy()
		error("Your character is still loading. Try again in a moment.")
	end

	model.Name = "LocalAvatarPreview"
	model:SetAttribute("LocalAvatarPreview", true)
	model:SetAttribute("PreviewName", displayName)
	if sourceUserId then
		model:SetAttribute("SourceUserId", sourceUserId)
	end
	humanoid.DisplayName = displayName
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff

	for _, item in ipairs(model:GetDescendants()) do
		if item:IsA("BasePart") then
			item.CanCollide = false
			item.CanTouch = false
			item.CanQuery = false
		end
	end

	model.Parent = workspace
	model:PivotTo(playerRoot.CFrame)
	local _, playerBounds = character:GetBoundingBox()
	local _, modelBounds = model:GetBoundingBox()
	local rearOffset = (playerBounds.Z + modelBounds.Z) / 2 + FIVE_INCHES_IN_STUDS
	model:PivotTo(playerRoot.CFrame * CFrame.new(0, 0, rearOffset))
	root.Anchored = true

	table.insert(localPreviews, model)
	return displayName
end

local function getRandomUserIds()
	local ids = {}
	local seen = {}

	local function addId(userId)
		if typeof(userId) == "number" and userId > 0 and not seen[userId] then
			seen[userId] = true
			table.insert(ids, userId)
		end
	end

	for _, userId in ipairs(RANDOM_USER_IDS) do
		addId(userId)
	end
	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer ~= player then
			addId(otherPlayer.UserId)
		end
	end

	return ids
end

local function spawnRandomPreview()
	local ids = getRandomUserIds()
	for _ = 1, math.min(3, #ids) do
		local userId = table.remove(ids, rng:NextInteger(1, #ids))
		local avatarOk, description = pcall(function()
			return Players:GetHumanoidDescriptionFromUserIdAsync(userId)
		end)
		if avatarOk and description then
			local nameOk, name = pcall(function()
				return Players:GetNameFromUserIdAsync(userId)
			end)
			local previewOk, previewName = pcall(function()
				return createLocalPreview(description, nameOk and name or "Random Player", userId)
			end)
			if previewOk then
				return previewName
			end
		end
	end

	return createLocalPreview(randomDescription(), "Random Avatar")
end

local function spawnNamedPreview(username)
	local cleanName = string.match(username, "^%s*(.-)%s*$") or ""
	if #cleanName < 3 or #cleanName > 20 or not string.match(cleanName, "^[%w_]+$") then
		error("Enter a valid Roblox username.")
	end

	local userId = Players:GetUserIdFromNameAsync(cleanName)
	local description = Players:GetHumanoidDescriptionFromUserIdAsync(userId)
	return createLocalPreview(description, cleanName, userId)
end

local gui = create("ScreenGui", {
	Name = "EditableGamePanel",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	DisplayOrder = 20,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, playerGui)
gui.Destroying:Connect(clearLocalPreviews)

local window = create("Frame", {
	Name = "Window",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(720, 460),
	BackgroundColor3 = COLORS.background,
	BorderSizePixel = 0,
}, gui)
addCorner(window, 16)
addStroke(window, COLORS.border, 0.15)

local uiScale = create("UIScale", {Scale = 1}, window)

local function fitWindow()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local viewport = camera.ViewportSize
	if viewport.X <= 0 or viewport.Y <= 0 then
		return
	end
	uiScale.Scale = math.min(1, math.max(1, viewport.X - 24) / 720, math.max(1, viewport.Y - 24) / 460)

	local size = window.AbsoluteSize
	local center = window.AbsolutePosition + size / 2
	local halfWidth = math.min(size.X / 2, viewport.X / 2)
	local halfHeight = math.min(size.Y / 2, viewport.Y / 2)
	window.Position = UDim2.fromOffset(
		math.clamp(center.X, halfWidth, viewport.X - halfWidth),
		math.clamp(center.Y, halfHeight, viewport.Y - halfHeight)
	)
end

local header = create("Frame", {
	Name = "Header",
	Size = UDim2.new(1, 0, 0, 62),
	BackgroundColor3 = COLORS.panel,
	BorderSizePixel = 0,
}, window)
addCorner(header, 16)
create("Frame", {
	Position = UDim2.new(0, 0, 1, -16),
	Size = UDim2.new(1, 0, 0, 16),
	BackgroundColor3 = COLORS.panel,
	BorderSizePixel = 0,
}, header)

local accent = create("Frame", {
	Position = UDim2.fromOffset(20, 16),
	Size = UDim2.fromOffset(5, 30),
	BackgroundColor3 = COLORS.purple,
	BorderSizePixel = 0,
}, header)
addCorner(accent, 3)
create("UIGradient", {
	Color = ColorSequence.new(COLORS.purple, COLORS.cyan),
	Rotation = 90,
}, accent)

addLabel(header, "MY GAME", UDim2.fromOffset(38, 10), UDim2.fromOffset(210, 24), 17, COLORS.text, Enum.Font.GothamBold)
addLabel(header, "EDITABLE CONTROL PANEL", UDim2.fromOffset(39, 34), UDim2.fromOffset(220, 15), 9, COLORS.muted, Enum.Font.GothamMedium)

-- A transparent handle lets the title area drag the window on mouse or touch.
local dragHandle = create("TextButton", {
	Name = "DragHandle",
	Position = UDim2.fromOffset(0, 0),
	Size = UDim2.new(1, -62, 1, 0),
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	AutoButtonColor = false,
	Text = "",
	ZIndex = 5,
}, header)

local dragging = false
local dragInput
local dragStart
local startCenter

local function moveWindowTo(center)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local viewport = camera.ViewportSize
	local size = window.AbsoluteSize
	local halfWidth = math.min(size.X / 2, viewport.X / 2)
	local halfHeight = math.min(size.Y / 2, viewport.Y / 2)
	window.Position = UDim2.fromOffset(
		math.clamp(center.X, halfWidth, viewport.X - halfWidth),
		math.clamp(center.Y, halfHeight, viewport.Y - halfHeight)
	)
end

dragHandle.InputBegan:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	dragging = true
	dragStart = input.Position
	startCenter = window.AbsolutePosition + window.AbsoluteSize / 2
	input.Changed:Connect(function()
		if input.UserInputState == Enum.UserInputState.End then
			dragging = false
			dragInput = nil
		end
	end)
end)

dragHandle.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and dragInput and input == dragInput then
		moveWindowTo(startCenter + (input.Position - dragStart))
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
		dragInput = nil
	end
end)

local closeButton = create("TextButton", {
	Name = "CloseButton",
	AnchorPoint = Vector2.new(1, 0.5),
	Position = UDim2.new(1, -16, 0.5, 0),
	Size = UDim2.fromOffset(34, 34),
	BackgroundColor3 = COLORS.panelLight,
	BorderSizePixel = 0,
	AutoButtonColor = false,
	Font = Enum.Font.GothamBold,
	Text = "×",
	TextSize = 22,
	TextColor3 = COLORS.text,
	ZIndex = 6,
}, header)
addCorner(closeButton, 10)
closeButton.Activated:Connect(function()
	gui:Destroy()
end)

local sidebar = create("Frame", {
	Name = "Sidebar",
	Position = UDim2.fromOffset(0, 62),
	Size = UDim2.new(0, 168, 1, -62),
	BackgroundColor3 = COLORS.panel,
	BorderSizePixel = 0,
}, window)

addLabel(sidebar, "SECTIONS", UDim2.fromOffset(16, 18), UDim2.new(1, -32, 0, 20), 10, COLORS.muted, Enum.Font.GothamBold)

local content = create("Frame", {
	Name = "Content",
	Position = UDim2.fromOffset(168, 62),
	Size = UDim2.new(1, -168, 1, -62),
	BackgroundColor3 = COLORS.background,
	BorderSizePixel = 0,
}, window)

local sectionData = {
	{key = "Home", title = "Home", description = "Your editable game control panel is ready."},
	{key = "Players", title = "Players", description = "Add your own player tools here."},
	{key = "NPCs", title = "NPCs", description = "Add your own NPC features here."},
	{key = "Pets", title = "Pets", description = "Add your own pet features here."},
	{key = "Settings", title = "Settings", description = "Add your own settings here."},
}

local pages = {}
local navButtons = {}
local selectedSection = "Home"

local function makeActionButton(parent, text, position, size, baseColor, callback)
	local action = create("TextButton", {
		Position = position,
		Size = size,
		BackgroundColor3 = baseColor,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Font = Enum.Font.GothamBold,
		Text = text,
		TextSize = 12,
		TextColor3 = COLORS.text,
	}, parent)
	addCorner(action, 9)

	action.MouseEnter:Connect(function()
		TweenService:Create(action, TweenInfo.new(0.12), {
			BackgroundColor3 = baseColor:Lerp(Color3.new(1, 1, 1), 0.08),
		}):Play()
	end)
	action.MouseLeave:Connect(function()
		TweenService:Create(action, TweenInfo.new(0.12), {BackgroundColor3 = baseColor}):Play()
	end)
	action.Activated:Connect(callback)
	return action
end

local function selectSection(sectionName)
	selectedSection = sectionName
	for name, page in pairs(pages) do
		page.Visible = name == sectionName
	end
	for name, button in pairs(navButtons) do
		button.BackgroundColor3 = name == sectionName and COLORS.panelLight or COLORS.panel
		button.TextColor3 = name == sectionName and COLORS.text or COLORS.muted
	end
end

local function makePage(section)
	local page = create("Frame", {
		Name = section.key .. "Page",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
	}, content)
	pages[section.key] = page

	addLabel(page, section.title, UDim2.fromOffset(26, 22), UDim2.new(1, -52, 0, 34), 22, COLORS.text, Enum.Font.GothamBold)
	addLabel(page, section.description, UDim2.fromOffset(27, 56), UDim2.new(1, -54, 0, 26), 12, COLORS.muted)

	local card = create("Frame", {
		Position = UDim2.fromOffset(26, 104),
		Size = UDim2.new(1, -52, 0, section.key == "Players" and 258 or 164),
		BackgroundColor3 = COLORS.panel,
		BorderSizePixel = 0,
	}, page)
	addCorner(card, 13)
	addStroke(card, COLORS.border, 0.3)

	if section.key == "Players" then
		addLabel(card, "SPAWN A PLAYER AVATAR", UDim2.fromOffset(17, 13), UDim2.new(1, -34, 0, 19), 10, COLORS.cyan, Enum.Font.GothamBold)
		addLabel(card, "Enter a Roblox username, or create a randomized avatar.", UDim2.fromOffset(17, 36), UDim2.new(1, -34, 0, 27), 12, COLORS.text)

		local usernameBox = create("TextBox", {
			Name = "RobloxUsername",
			Position = UDim2.fromOffset(17, 72),
			Size = UDim2.new(1, -34, 0, 40),
			BackgroundColor3 = COLORS.panelLight,
			BorderSizePixel = 0,
			ClearTextOnFocus = false,
			Font = Enum.Font.Gotham,
			PlaceholderText = "Roblox username",
			PlaceholderColor3 = COLORS.muted,
			Text = "",
			TextColor3 = COLORS.text,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, card)
		addCorner(usernameBox, 9)
		addStroke(usernameBox, COLORS.border, 0.3)
		create("UIPadding", {
			PaddingLeft = UDim.new(0, 12),
			PaddingRight = UDim.new(0, 12),
		}, usernameBox)

		local status = addLabel(card, "Avatar previews appear behind you and are visible only to you.", UDim2.fromOffset(17, 207), UDim2.new(1, -34, 0, 36), 10, COLORS.muted)

		local function requestAvatar(action, username)
			if action == "Clear" then
				status.Text = ("Cleared %d local preview avatar(s)."):format(clearLocalPreviews())
				status.TextColor3 = COLORS.cyan
				return
			end
			if not canUseLocalPreview() then
				status.Text = "Local previews are enabled in Studio or your own experience."
				status.TextColor3 = COLORS.muted
				return
			end
			if isSpawning then
				return
			end

			if #getActivePreviews() >= MAX_PREVIEWS then
				status.Text = ("Clear a preview first; the limit is %d avatars."):format(MAX_PREVIEWS)
				status.TextColor3 = COLORS.muted
				return
			end
			if os.clock() - lastSpawnAt < SPAWN_COOLDOWN then
				status.Text = "Wait a moment before spawning another avatar."
				status.TextColor3 = COLORS.muted
				return
			end

			isSpawning = true
			lastSpawnAt = os.clock()
			status.Text = action == "SpawnRandom" and "Creating a random avatar locally..." or "Loading Roblox avatar locally..."
			status.TextColor3 = COLORS.muted
			local callOk, result = pcall(function()
				if action == "SpawnUser" then
					return spawnNamedPreview(username or "")
				elseif action == "SpawnRandom" then
					return spawnRandomPreview()
				end
				error("Unknown avatar action.")
			end)
			isSpawning = false

			if not callOk then
				warn("[LocalAvatarPreview] " .. tostring(result))
				status.Text = "Couldn't load avatar: " .. string.sub(string.gsub(tostring(result), "[\r\n]+", " "), 1, 94)
				status.TextColor3 = COLORS.muted
				return
			end

			status.Text = "Spawned " .. tostring(result) .. " behind you (only visible to you)."
			status.TextColor3 = COLORS.cyan
		end

		makeActionButton(card, "Spawn this user", UDim2.fromOffset(17, 124), UDim2.new(0.5, -22, 0, 34), COLORS.purple, function()
			local username = string.match(usernameBox.Text, "^%s*(.-)%s*$")
			if not username or username == "" then
				status.Text = "Enter a Roblox username first."
				return
			end
			requestAvatar("SpawnUser", username)
		end)

		makeActionButton(card, "Spawn random player", UDim2.new(0.5, 5, 0, 124), UDim2.new(0.5, -22, 0, 34), COLORS.panelLight, function()
			requestAvatar("SpawnRandom")
		end)

		makeActionButton(card, "Clear my spawned avatars", UDim2.fromOffset(17, 166), UDim2.fromOffset(190, 30), Color3.fromRGB(102, 54, 74), function()
			requestAvatar("Clear")
		end)

		usernameBox.FocusLost:Connect(function(enterPressed)
			if enterPressed and usernameBox.Text ~= "" then
				requestAvatar("SpawnUser", usernameBox.Text)
			end
		end)
	else
		addLabel(card, "FEATURE PLACEHOLDER", UDim2.fromOffset(17, 13), UDim2.new(1, -34, 0, 19), 10, COLORS.cyan, Enum.Font.GothamBold)
		addLabel(card, "This section is ready for the functions you choose to add.", UDim2.fromOffset(17, 40), UDim2.new(1, -34, 0, 42), 13, COLORS.text)

		local status = addLabel(card, "No action connected yet.", UDim2.fromOffset(17, 91), UDim2.new(1, -34, 0, 22), 11, COLORS.muted)
		makeActionButton(card, "Example button", UDim2.fromOffset(17, 122), UDim2.fromOffset(145, 30), COLORS.purple, function()
			status.Text = "Button works. Replace this callback with your game feature."
			status.TextColor3 = COLORS.cyan
		end)
	end
end

for index, section in ipairs(sectionData) do
	makePage(section)
	local nav = create("TextButton", {
		Name = section.key .. "Button",
		Position = UDim2.fromOffset(10, 48 + ((index - 1) * 45)),
		Size = UDim2.new(1, -20, 0, 38),
		BackgroundColor3 = COLORS.panel,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Font = Enum.Font.GothamMedium,
		Text = "   " .. section.title,
		TextSize = 12,
		TextColor3 = COLORS.muted,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, sidebar)
	addCorner(nav, 9)
	navButtons[section.key] = nav
	nav.Activated:Connect(function()
		selectSection(section.key)
	end)
end

local footer = addLabel(sidebar, "Client-only preview panel for your own test experience.", UDim2.new(0, 14, 1, -16), UDim2.new(1, -28, 0, 58), 10, COLORS.muted)
footer.AnchorPoint = Vector2.new(0, 1)

selectSection(selectedSection)
fitWindow()

if workspace.CurrentCamera then
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fitWindow)
end
