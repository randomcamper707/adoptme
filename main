makeTab(subTabs, "☻ Users", 0.34, true)
makeTab(subTabs, "⚙ Sets", 0.33, false)
makeTab(subTabs, "▣ Inventory", 0.33, false)

-- Scrollable control area
local content = Instance.new("ScrollingFrame")
content.Name = "Controls"
content.Position = UDim2.new(0, 4, 0, 89)
content.Size = UDim2.new(1, -8, 1, -93)
content.BackgroundTransparency = 1
content.BorderSizePixel = 0
content.ScrollBarThickness = 3
content.ScrollBarImageColor3 = COLORS.muted
content.CanvasSize = UDim2.new()
content.AutomaticCanvasSize = Enum.AutomaticSize.Y
content.Parent = panel

local contentPadding = Instance.new("UIPadding")
contentPadding.PaddingLeft = UDim.new(0, 1)
contentPadding.PaddingRight = UDim.new(0, 1)
contentPadding.PaddingTop = UDim.new(0, 2)
contentPadding.PaddingBottom = UDim.new(0, 6)
contentPadding.Parent = content

local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 5)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = content

local function addField(labelText, defaultValue)
	local group = Instance.new("Frame")
	group.Size = UDim2.new(1, 0, 0, 40)
	group.BackgroundTransparency = 1
	group.Parent = content

	makeLabel(
		group,
		labelText,
		UDim2.new(1, 0, 0, 14),
		UDim2.new(),
		9,
		COLORS.muted,
		false
	)

	local box = Instance.new("TextBox")
	box.Size = UDim2.new(1, 0, 0, 25)
	box.Position = UDim2.new(0, 0, 0, 15)
	box.BackgroundColor3 = COLORS.surface
	box.BorderSizePixel = 0
	box.ClearTextOnFocus = false
	box.Font = Enum.Font.Gotham
	box.PlaceholderColor3 = COLORS.muted
	box.Text = defaultValue
	box.TextColor3 = COLORS.text
	box.TextSize = 10
	box.TextXAlignment = Enum.TextXAlignment.Center
	box.Parent = group

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 5)
	corner.Parent = box

	local stroke = Instance.new("UIStroke")
	stroke.Color = COLORS.border
	stroke.Thickness = 1
	stroke.Parent = box

	return box
end

addField("Partner Username", "endeavor3313")
addField("Accept Delay (s)", "0.2")
addField("Confirm Delay (s)", "0.3")
addField("Spectator Count", "4")
addField("Request Delay (s)", "0")

