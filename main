local function makeButton(name, label, position, size, baseColor)
    local button = Instance.new("TextButton")
    button.Name = name
    button.Position = position
    button.Size = size
    button.BackgroundColor3 = baseColor
    button.BorderSizePixel = 0
    button.AutoButtonColor = false
    button.Font = Enum.Font.GothamBold
    button.Text = label
    button.TextColor3 = Color3.fromRGB(250, 247, 252)
    button.TextSize = 10
    button.Parent = panel

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 9)
    corner.Parent = button

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(132, 105, 151)
    stroke.Transparency = 0.77
    stroke.Thickness = 1
    stroke.Parent = button

    local original = baseColor
    button.MouseEnter:Connect(function()
        button.BackgroundColor3 = Color3.fromRGB(72, 48, 91)
    end)
    button.MouseLeave:Connect(function()
        button.BackgroundColor3 = original
    end)

    return button
end

local morphButton = makeButton(
    "MorphButton",
    "MORPH",
    UDim2.fromOffset(3, 127),
    UDim2.new(0.61, -4, 0, 39),
    Color3.fromRGB(43, 30, 56)
)
