-- Editable Roblox UI base
-- Place this LocalScript in StarterPlayer > StarterPlayerScripts.
-- This file contains only UI and tab navigation. Feature buttons are safe placeholders
-- for the game-specific functions you decide to add later.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local avatarRemote = ReplicatedStorage:WaitForChild("OwnGameAvatarSpawner", 15)

local oldGui = playerGui:FindFirstChild("EditableGamePanel")
if oldGui then
	oldGui:Destroy()
end

local COLORS = {
	background = Color3.fromRGB(17, 19, 29),
	panel = Color3.fromRGB(25, 28, 41),
	panelLight = Color3.fromRGB(36, 40, 57),
	border = Color3.fromRGB(62, 68, 91),
	text = Color3.fromRGB(244, 245, 255),
	muted = Color3.fromRGB(157, 165, 188),
	purple = Color3.fromRGB(137, 105, 255),
	cyan = Color3.fromRGB(83, 207, 226),
}

local function create(className, properties, parent)
	local object = Instance.new(className)
	for property, value in pairs(properties) do
		object[property] = value
	end
	object.Parent = parent
	return object
end

local function addCorner(object, radius)
	create("UICorner", {CornerRadius = UDim.new(0, radius)}, object)
end

local function addStroke(object, color, transparency)
	create("UIStroke", {
		Color = color or COLORS.border,
		Transparency = transparency or 0,
		Thickness = 1,
	}, object)
end

local function addLabel(parent, text, position, size, fontSize, color, font)
	return create("TextLabel", {
		BackgroundTransparency = 1,
		Position = position,
		Size = size,
		Font = font or Enum.Font.Gotham,
		Text = text,
		TextSize = fontSize,
		TextColor3 = color or COLORS.text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextWrapped = true,
	}, parent)
end

local gui = create("ScreenGui", {
	Name = "EditableGamePanel",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	DisplayOrder = 20,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, playerGui)

local window = create("Frame", {
	Name = "Window",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(720, 460),
	BackgroundColor3 = COLORS.background,
	BorderSizePixel = 0,
}, gui)
addCorner(window, 16)
addStroke(window, COLORS.border, 0.15)

local uiScale = create("UIScale", {Scale = 1}, window)

local function fitWindow()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local viewport = camera.ViewportSize
	uiScale.Scale = math.min(1, (viewport.X - 24) / 720, (viewport.Y - 24) / 460)
end

local header = create("Frame", {
	Name = "Header",
	Size = UDim2.new(1, 0, 0, 62),
	BackgroundColor3 = COLORS.panel,
	BorderSizePixel = 0,
}, window)
addCorner(header, 16)
create("Frame", {
	Position = UDim2.new(0, 0, 1, -16),
	Size = UDim2.new(1, 0, 0, 16),
	BackgroundColor3 = COLORS.panel,
	BorderSizePixel = 0,
}, header)

local accent = create("Frame", {
	Position = UDim2.fromOffset(20, 16),
	Size = UDim2.fromOffset(5, 30),
	BackgroundColor3 = COLORS.purple,
	BorderSizePixel = 0,
}, header)
addCorner(accent, 3)
create("UIGradient", {
	Color = ColorSequence.new(COLORS.purple, COLORS.cyan),
	Rotation = 90,
}, accent)

addLabel(header, "MY GAME", UDim2.fromOffset(38, 10), UDim2.fromOffset(210, 24), 17, COLORS.text, Enum.Font.GothamBold)
addLabel(header, "EDITABLE CONTROL PANEL", UDim2.fromOffset(39, 34), UDim2.fromOffset(220, 15), 9, COLORS.muted, Enum.Font.GothamMedium)

local closeButton = create("TextButton", {
	Name = "CloseButton",
	AnchorPoint = Vector2.new(1, 0.5),
	Position = UDim2.new(1, -16, 0.5, 0),
	Size = UDim2.fromOffset(34, 34),
	BackgroundColor3 = COLORS.panelLight,
	BorderSizePixel = 0,
	AutoButtonColor = false,
	Font = Enum.Font.GothamBold,
	Text = "×",
	TextSize = 22,
	TextColor3 = COLORS.text,
}, header)
addCorner(closeButton, 10)
closeButton.Activated:Connect(function()
	gui:Destroy()
end)

local sidebar = create("Frame", {
	Name = "Sidebar",
	Position = UDim2.fromOffset(0, 62),
	Size = UDim2.new(0, 168, 1, -62),
	BackgroundColor3 = COLORS.panel,
	BorderSizePixel = 0,
}, window)

addLabel(sidebar, "SECTIONS", UDim2.fromOffset(16, 18), UDim2.new(1, -32, 0, 20), 10, COLORS.muted, Enum.Font.GothamBold)

local content = create("Frame", {
	Name = "Content",
	Position = UDim2.fromOffset(168, 62),
	Size = UDim2.new(1, -168, 1, -62),
	BackgroundColor3 = COLORS.background,
	BorderSizePixel = 0,
}, window)

local sectionData = {
	{key = "Home", title = "Home", description = "Your editable game control panel is ready."},
	{key = "Players", title = "Players", description = "Add your own player tools here."},
	{key = "NPCs", title = "NPCs", description = "Add your own NPC features here."},
	{key = "Pets", title = "Pets", description = "Add your own pet features here."},
	{key = "Settings", title = "Settings", description = "Add your own settings here."},
}

local pages = {}
local navButtons = {}
local selectedSection = "Home"

local function makeActionButton(parent, text, position, size, baseColor, callback)
	local action = create("TextButton", {
		Position = position,
		Size = size,
		BackgroundColor3 = baseColor,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Font = Enum.Font.GothamBold,
		Text = text,
		TextSize = 12,
		TextColor3 = COLORS.text,
	}, parent)
	addCorner(action, 9)

	action.MouseEnter:Connect(function()
		TweenService:Create(action, TweenInfo.new(0.12), {
			BackgroundColor3 = baseColor:Lerp(Color3.new(1, 1, 1), 0.08),
		}):Play()
	end)
	action.MouseLeave:Connect(function()
		TweenService:Create(action, TweenInfo.new(0.12), {BackgroundColor3 = baseColor}):Play()
	end)
	action.Activated:Connect(callback)
	return action
end

local function selectSection(sectionName)
	selectedSection = sectionName
	for name, page in pairs(pages) do
		page.Visible = name == sectionName
	end
	for name, button in pairs(navButtons) do
		button.BackgroundColor3 = name == sectionName and COLORS.panelLight or COLORS.panel
		button.TextColor3 = name == sectionName and COLORS.text or COLORS.muted
	end
end

local function makePage(section)
	local page = create("Frame", {
		Name = section.key .. "Page",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
	}, content)
	pages[section.key] = page

	addLabel(page, section.title, UDim2.fromOffset(26, 22), UDim2.new(1, -52, 0, 34), 22, COLORS.text, Enum.Font.GothamBold)
	addLabel(page, section.description, UDim2.fromOffset(27, 56), UDim2.new(1, -54, 0, 26), 12, COLORS.muted)

	local card = create("Frame", {
		Position = UDim2.fromOffset(26, 104),
		Size = UDim2.new(1, -52, 0, section.key == "Players" and 258 or 164),
		BackgroundColor3 = COLORS.panel,
		BorderSizePixel = 0,
	}, page)
	addCorner(card, 13)
	addStroke(card, COLORS.border, 0.3)

	if section.key == "Players" then
		addLabel(card, "SPAWN A PLAYER AVATAR", UDim2.fromOffset(17, 13), UDim2.new(1, -34, 0, 19), 10, COLORS.cyan, Enum.Font.GothamBold)
		addLabel(card, "Enter a Roblox username, or create a randomized avatar.", UDim2.fromOffset(17, 36), UDim2.new(1, -34, 0, 27), 12, COLORS.text)

		local usernameBox = create("TextBox", {
			Name = "RobloxUsername",
			Position = UDim2.fromOffset(17, 72),
			Size = UDim2.new(1, -34, 0, 40),
			BackgroundColor3 = COLORS.panelLight,
			BorderSizePixel = 0,
			ClearTextOnFocus = false,
			Font = Enum.Font.Gotham,
			PlaceholderText = "Roblox username",
			PlaceholderColor3 = COLORS.muted,
			Text = "",
			TextColor3 = COLORS.text,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, card)
		addCorner(usernameBox, 9)
		addStroke(usernameBox, COLORS.border, 0.3)
		create("UIPadding", {
			PaddingLeft = UDim.new(0, 12),
			PaddingRight = UDim.new(0, 12),
		}, usernameBox)

		local status = addLabel(card, "Test avatars spawn behind you in your own game.", UDim2.fromOffset(17, 207), UDim2.new(1, -34, 0, 36), 10, COLORS.muted)

		local function requestAvatar(action, username)
			if not avatarRemote then
				status.Text = "Add the server spawner script to ServerScriptService."
				return
			end

			status.Text = "Loading avatar..."
			status.TextColor3 = COLORS.muted
			local callOk, accepted, result = pcall(function()
				return avatarRemote:InvokeServer(action, username)
			end)

			if not callOk then
				status.Text = "The server did not respond."
				return
			end
			if not accepted then
				status.Text = tostring(result)
				return
			end

			if action == "Clear" then
				status.Text = ("Cleared %d spawned avatar(s)."):format(result.removed)
			else
				status.Text = "Spawned " .. tostring(result.name) .. " behind you."
			end
			status.TextColor3 = COLORS.cyan
		end

		makeActionButton(card, "Spawn this user", UDim2.fromOffset(17, 124), UDim2.new(0.5, -22, 0, 34), COLORS.purple, function()
			local username = string.match(usernameBox.Text, "^%s*(.-)%s*$")
			if not username or username == "" then
				status.Text = "Enter a Roblox username first."
				return
			end
			requestAvatar("SpawnUser", username)
		end)

		makeActionButton(card, "Spawn random avatar", UDim2.new(0.5, 5, 0, 124), UDim2.new(0.5, -22, 0, 34), COLORS.panelLight, function()
			requestAvatar("SpawnRandom")
		end)

		makeActionButton(card, "Clear my spawned avatars", UDim2.fromOffset(17, 166), UDim2.fromOffset(190, 30), Color3.fromRGB(102, 54, 74), function()
			requestAvatar("Clear")
		end)

		usernameBox.FocusLost:Connect(function(enterPressed)
			if enterPressed and usernameBox.Text ~= "" then
				requestAvatar("SpawnUser", usernameBox.Text)
			end
		end)
	else
		addLabel(card, "FEATURE PLACEHOLDER", UDim2.fromOffset(17, 13), UDim2.new(1, -34, 0, 19), 10, COLORS.cyan, Enum.Font.GothamBold)
		addLabel(card, "This section is ready for the functions you choose to add.", UDim2.fromOffset(17, 40), UDim2.new(1, -34, 0, 42), 13, COLORS.text)

		local status = addLabel(card, "No action connected yet.", UDim2.fromOffset(17, 91), UDim2.new(1, -34, 0, 22), 11, COLORS.muted)
		makeActionButton(card, "Example button", UDim2.fromOffset(17, 122), UDim2.fromOffset(145, 30), COLORS.purple, function()
			status.Text = "Button works. Replace this callback with your game feature."
			status.TextColor3 = COLORS.cyan
		end)
	end
end

for index, section in ipairs(sectionData) do
	makePage(section)
	local nav = create("TextButton", {
		Name = section.key .. "Button",
		Position = UDim2.fromOffset(10, 48 + ((index - 1) * 45)),
		Size = UDim2.new(1, -20, 0, 38),
		BackgroundColor3 = COLORS.panel,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Font = Enum.Font.GothamMedium,
		Text = "   " .. section.title,
		TextSize = 12,
		TextColor3 = COLORS.muted,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, sidebar)
	addCorner(nav, 9)
	navButtons[section.key] = nav
	nav.Activated:Connect(function()
		selectSection(section.key)
	end)
end

local footer = addLabel(sidebar, "Standalone UI base. Connect only to systems in your own game.", UDim2.new(0, 14, 1, -16), UDim2.new(1, -28, 0, 58), 10, COLORS.muted)
footer.AnchorPoint = Vector2.new(0, 1)

selectSection(selectedSection)
fitWindow()

if workspace.CurrentCamera then
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fitWindow)
end
