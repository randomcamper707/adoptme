-- UI only. Put this LocalScript in StarterPlayerScripts or StarterGui.
-- Connect your own supported functions to the controls later.

local Players = game:GetService("Players")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local UserInputService = game:GetService("UserInputService")

local oldGui = playerGui:FindFirstChild("CartiScriptsUI")
if oldGui then
	oldGui:Destroy()
end

local COLORS = {
	background = Color3.fromRGB(31, 31, 39),
	surface = Color3.fromRGB(39, 39, 48),
	border = Color3.fromRGB(66, 66, 78),
	text = Color3.fromRGB(245, 245, 249),
	muted = Color3.fromRGB(177, 177, 188),
	red = Color3.fromRGB(133, 48, 52),
	purple = Color3.fromRGB(94, 48, 137),
	green = Color3.fromRGB(43, 119, 56),
	blue = Color3.fromRGB(74, 76, 161),
	orange = Color3.fromRGB(145, 63, 20),
}

local gui = Instance.new("ScreenGui")
gui.Name = "CartiScriptsUI"
gui.ResetOnSpawn = false
gui.Parent = playerGui

local panel = Instance.new("Frame")
panel.Name = "Panel"
panel.AnchorPoint = Vector2.new(0.5, 0.5)
panel.Position = UDim2.fromScale(0.5, 0.5)
panel.Size = UDim2.new(0, 230, 0.92, 0)
panel.BackgroundColor3 = COLORS.background
panel.BorderSizePixel = 0
panel.Parent = gui

local sizeConstraint = Instance.new("UISizeConstraint")
sizeConstraint.MinSize = Vector2.new(210, 440)
sizeConstraint.MaxSize = Vector2.new(300, 800)
sizeConstraint.Parent = panel

local panelStroke = Instance.new("UIStroke")
panelStroke.Color = COLORS.border
panelStroke.Thickness = 1
panelStroke.Parent = panel

local function makeLabel(parent, text, size, position, textSize, color, bold)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = size
	label.Position = position
	label.Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham
	label.Text = text
	label.TextColor3 = color or COLORS.text
	label.TextSize = textSize or 11
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.Parent = parent
	return label
end

local function makeButton(parent, text, color, height)
	local button = Instance.new("TextButton")
	button.Name = text:gsub("%W", "") .. "Button"
	button.Size = UDim2.new(1, 0, 0, height or 30)
	button.BackgroundColor3 = color or COLORS.surface
	button.BorderSizePixel = 0
	button.AutoButtonColor = true
	button.Font = Enum.Font.GothamBold
	button.Text = text
	button.TextColor3 = COLORS.text
	button.TextSize = 11
	button.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 5)
	corner.Parent = button

	local stroke = Instance.new("UIStroke")
	stroke.Color = color or COLORS.border
	stroke.Thickness = 1
	stroke.Parent = button

	return button
end

local function makeTab(parent, text, widthScale, active)
	local button = Instance.new("TextButton")
	button.Size = UDim2.new(widthScale, -3, 1, 0)
	button.BackgroundColor3 = active and COLORS.surface or COLORS.background
	button.BorderSizePixel = 0
	button.Font = Enum.Font.GothamBold
	button.Text = text
	button.TextColor3 = active and COLORS.text or COLORS.muted
	button.TextSize = 10
	button.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 5)
	corner.Parent = button
	return button
end

-- Header
local accent = Instance.new("Frame")
accent.Size = UDim2.new(1, 0, 0, 2)
accent.BackgroundColor3 = Color3.fromRGB(221, 220, 58)
accent.BorderSizePixel = 0
accent.Parent = panel

-- Blank strip for dragging the panel.
local dragHandle = Instance.new("TextButton")
dragHandle.Name = "DragHandle"
dragHandle.Position = UDim2.new(0, 6, 0, 4)
dragHandle.Size = UDim2.new(1, -12, 0, 19)
dragHandle.BackgroundColor3 = Color3.fromRGB(48, 48, 59)
dragHandle.BorderSizePixel = 0
dragHandle.AutoButtonColor = false
dragHandle.Font = Enum.Font.GothamBold
dragHandle.Text = "DRAG PANEL"
dragHandle.TextColor3 = COLORS.muted
dragHandle.TextSize = 9
dragHandle.Active = true
dragHandle.Parent = panel

local dragCorner = Instance.new("UICorner")
dragCorner.CornerRadius = UDim.new(0, 4)
dragCorner.Parent = dragHandle

local dragStroke = Instance.new("UIStroke")
dragStroke.Color = COLORS.border
dragStroke.Thickness = 1
dragStroke.Parent = dragHandle

dragHandle.MouseEnter:Connect(function()
	dragHandle.BackgroundColor3 = Color3.fromRGB(61, 61, 75)
	dragHandle.TextColor3 = COLORS.text
end)

dragHandle.MouseLeave:Connect(function()
	dragHandle.BackgroundColor3 = Color3.fromRGB(48, 48, 59)
	dragHandle.TextColor3 = COLORS.muted
end)

local dragging = false
local dragStart
local startPosition

dragHandle.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPosition = panel.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not dragging then return end

	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		local delta = input.Position - dragStart
		panel.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end
end)

-- Main tabs
local mainTabs = Instance.new("Frame")
mainTabs.BackgroundTransparency = 1
mainTabs.Position = UDim2.new(0, 4, 0, 26)
mainTabs.Size = UDim2.new(1, -8, 0, 27)
mainTabs.Parent = panel

local mainTabLayout = Instance.new("UIListLayout")
mainTabLayout.FillDirection = Enum.FillDirection.Horizontal
mainTabLayout.Padding = UDim.new(0, 3)
mainTabLayout.SortOrder = Enum.SortOrder.LayoutOrder
mainTabLayout.Parent = mainTabs

makeTab(mainTabs, "⚙ Control", 0.34, true)
makeTab(mainTabs, "♟ Players", 0.33, false)
makeTab(mainTabs, "♧ Pets", 0.33, false)

-- Subtabs
local subTabs = Instance.new("Frame")
subTabs.BackgroundTransparency = 1
subTabs.Position = UDim2.new(0, 4, 0, 57)
subTabs.Size = UDim2.new(1, -8, 0, 27)
subTabs.Parent = panel

