    "ResetButton",
    "RESET",
    UDim2.new(0.63, 0, 0, 127),
    UDim2.new(0.37, -4, 0, 39),
    Color3.fromRGB(43, 30, 56)
)

local roleLabel = Instance.new("TextLabel")
roleLabel.Name = "RoleLabel"
roleLabel.BackgroundTransparency = 1
roleLabel.Position = UDim2.fromOffset(4, 174)
roleLabel.Size = UDim2.new(1, -8, 0, 13)
roleLabel.Font = Enum.Font.GothamBold
roleLabel.Text = "OVERHEAD ROLE"
roleLabel.TextColor3 = Color3.fromRGB(180, 166, 193)
roleLabel.TextSize = 8
roleLabel.TextXAlignment = Enum.TextXAlignment.Left
roleLabel.Parent = panel

local roleButtons = {}
local roleNames = {"OWNER", "CO-OWNER", "ADMIN"}
local selectedRole = "OWNER"

local function updateRoleButtons()
    for roleName, button in pairs(roleButtons) do
        local active = roleName == selectedRole
        button.BackgroundColor3 = active and Color3.fromRGB(255, 65, 70) or Color3.fromRGB(43, 30, 56)
        button.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
end

for index, roleName in ipairs(roleNames) do
    local xScale = (index - 1) / 3
    local button = makeButton(
        roleName:gsub("%W", "") .. "RoleButton",
        roleName,
        UDim2.new(xScale, 3, 0, 193),
        UDim2.new(1 / 3, -6, 0, 31),
        Color3.fromRGB(43, 30, 56)
    )
    roleButtons[roleName] = button
    button.MouseButton1Click:Connect(function()
        selectedRole = roleName
        updateRoleButtons()
    end)
    button.MouseLeave:Connect(updateRoleButtons)
end
updateRoleButtons()

local footer = Instance.new("TextLabel")
footer.Name = "FooterNote"
footer.BackgroundTransparency = 1
footer.Position = UDim2.fromOffset(4, 228)
footer.Size = UDim2.new(1, -8, 0, 14)
